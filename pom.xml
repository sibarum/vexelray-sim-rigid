<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.sim</groupId>
    <artifactId>vexelray-sim-rigid</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>vexelray-sim-rigid</name>
    <description>
        Rigid-body simulation for VexelRay: bodies, contact and constraints. The simulation is SupirVast IR in -core
        and the stack is in -gui. It knows nothing of water: coupling to the fluid is vexelray-sim-physics'.
    </description>

    <modules>
        <!-- The simulation itself, authored as SupirVast IR: one program that lowers to SPIR-V for the GPU and
             runs on the CPU for anything else. No engine, no window. -->
        <module>vexelray-sim-rigid-core</module>
        <!-- The simulation on the VexelRay stack: a runner on resident buffers, and a view of what it holds. -->
        <module>vexelray-sim-rigid-gui</module>
        <!-- The experiments, on screen, with their readings; its timing is Kronometer's. -->
        <module>vexelray-sim-rigid-demo</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- The stack, installed to the local .m2 from the sibling checkouts. -->
        <supirvast.version>0.2.0-SNAPSHOT</supirvast.version>
        <vexelray.gui.version>0.1.0-SNAPSHOT</vexelray.gui.version>
        <vexelray.sim.core.version>0.1.0-SNAPSHOT</vexelray.sim.core.version>
        <vexelray.version>0.1.0-SNAPSHOT</vexelray.version>
        <vexelray.framework.version>0.1.0-SNAPSHOT</vexelray.framework.version>
        <tactroller.version>1.0-SNAPSHOT</tactroller.version>
        <kronometer.version>1.0-SNAPSHOT</kronometer.version>

        <junit.version>5.11.4</junit.version>

        <!-- Tests tagged "physics" run seconds of simulated time and judge what the bodies did; they take minutes,
             so a build leaves them out. mvn test -Pphysics runs them as well. -->
        <test.excludedGroups>physics</test.excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Reactor-internal modules: children reference these without a version. -->
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-rigid-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-rigid-gui</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Time: the physics rate, its tempo, and the handoff of its steps to the render thread. -->
            <dependency>
                <groupId>sibarum.kronometer</groupId>
                <artifactId>kronometer-core</artifactId>
                <version>${kronometer.version}</version>
            </dependency>
            <!-- The render target, storage binding and pipeline the view draws through. -->
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-vulkan</artifactId>
                <version>${vexelray.version}</version>
            </dependency>

            <!-- What the simulations share. -->
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-core</artifactId>
                <version>${vexelray.sim.core.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-core-gui</artifactId>
                <version>${vexelray.sim.core.version}</version>
            </dependency>

            <dependency>
                <groupId>dev.supirvast</groupId>
                <artifactId>vastir</artifactId>
                <version>${supirvast.version}</version>
            </dependency>
            <!-- The CPU backend that runs the IR, and the accelerator that runs it on the GPU. -->
            <dependency>
                <groupId>dev.supirvast</groupId>
                <artifactId>vast</artifactId>
                <version>${supirvast.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.supirvast</groupId>
                <artifactId>vastir-tools</artifactId>
                <version>${supirvast.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-core</artifactId>
                <version>${vexelray.gui.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-harness</artifactId>
                <version>${vexelray.gui.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <!-- Explicit release on the plugin as well as the property, so IDEs pick up the Java 25
                         language level reliably. Same as the sibling repos. -->
                    <configuration>
                        <target>${maven.compiler.release}</target>
                        <release>${maven.compiler.release}</release>
                        <compilerArgs>
                            <arg>-Xdoclint:reference,syntax</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <excludedGroups>${test.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>physics</id>
            <properties>
                <test.excludedGroups />
            </properties>
        </profile>
    </profiles>
</project>
